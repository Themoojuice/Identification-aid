logy/Cephalothorax%20length/Cephalothorax_length.jpg","type":1}]},{"id":37,"uid":"70ce4d24-edda-4d86-aee5-27957e8de22e","name":"medium 3-7mm","type":0,"feature":28,"images":[{"caption":"Measurement of cephalothorax length<br/>Illustrator (and &copy;) M. Żabka (QMB)","path":"Images/features/Aspects%20of%20general%20morphology/Cephalothorax%20length/Cephalothorax_length.jpg","thumb_path":"Thumbs/features/Aspects%20of%20general%20morphology/Cephalothorax%20length/Cephalothorax_length.jpg","type":1}]},{"id":38,"uid":"4eaad6b8-3f26-4340-9279-02af244b910b","name":"anterior hair mat present","type":0,"feature":29,"images":[{"caption":"Example of a thick anterior hair mat<br/>Illustrator (and &copy;) M. Żabka (QMB)","comments":"The hair mat is distinctly different from the general hair covering of the cephalothorax. The hairs are often rubbed off in preserved specimens.","path":"Images/features/Aspects%20of%20general%20morphology/Anterior%20Hair%20Pattern/Anterior_hair_mat_present.jpg","thumb_path":"Thumbs/features/Aspects%20of%20general%20morphology/Anterior%20Hair%20Pattern/Anterior_hair_mat_present.jpg","type":1}]},{"id":39,"uid":"25771517-5df4-4bd9-852d-567e75e0200a","name":"anterior hair mat absent","type":0,"feature":29,"images":[{"caption":"Example of a cephalothorax without a thick mat  or fringe<br/>Illustrator (and &copy;) B.J. Richardson (CSIRO)","comments":"While there may be a covering of hairs over the entire upper surface of the cephalothorax, it does not form a thick, almost carpet-like, covering over the anterior half. The hairs are often rubbed off in preserved specimens.","path":"Images/features/Aspects%20of%20general%20morphology/Anterior%20Hair%20Pattern/Anterior_hair_mat_absent.jpg","thumb_path":"Thumbs/features/Aspects%20of%20general%20morphology/Anterior%20Hair%20Pattern/Anterior_hair_mat_absent.jpg","type":1}]},{"id":40,"uid":"064c59cc-9634-4163-a6df-c370f01ee2f4","name":"thick anterior fringe","type":0,"feature":29,"images":[{"caption":"Illustrator