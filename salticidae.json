tch_type":0,"weight":1.0,"single_choice":false,"states":[291,292,293,294,295,296]}],"states":[{"id":1,"uid":"6f3e220d-8c33-47c3-b667-4100ae15f951","name":"male(s) only","type":0,"feature":16},{"id":2,"uid":"43fb619c-81de-45e1-b369-fb102e02e750","name":"female(s) only","type":0,"feature":16},{"id":3,"uid":"52604e85-4a12-4a0e-9ed9-5ab54dbd326b","name":"male(s) and female(s)","type":0,"feature":16},{"id":4,"uid":"6da420c9-520a-4116-8257-95baaf8c9240","name":"sex(es) unknown","type":0,"feature":16},{"id":5,"uid":"5b458d82-3731-4ebe-a0cf-b036dd538fe2","name":"No","type":0,"feature":17},{"id":6,"uid":"5e46cf70-566f-4876-b81a-226669efbfe8","name":"Yes","type":0,"feature":17},{"id":7,"uid":"a64edb12-11b9-4702-8672-45b8ad5ca48a","name":"standard jumping spider","type":0,"feature":18,"images":[{"caption":"Examples showing the range of normal body forms<br/>Illustrators (and &copy;) A. Lance (TL), R. Whyte (BR), I. R. Macaulay","comments":"Animals vary in shape from small and rounded to very elongated or large","path":"Images/features/Aspects%20of%20general%20morphology/Body%20form/body_form_standard.jpg","thumb_path":"Thumbs/features/Aspects%20of%20general%20morphology/Body%20form/body_form_standard.jpg","type":1}]},{"id":8,"uid":"a0a40643-be51-46c2-b52e-7c071244b8f9","name":"ant-like","type":0,"feature":18,"images":[{"caption":"Examples of ant-like forms<br/>Illustrators (and &copy;) R. Whyte (BL), I.R, Macaulay","comments":"Mimics can closely resemble particular ant species or just vaguely resemble ants. Behaviour (e.g. walking style, leg1 held like antennae) can also be ant-like.","path":"Images/features/Aspects%20of%20general%20morphology/Body%20form/body_form_ant.jpg","thumb_path":"Thumbs/features/Aspects%20of%20general%20morphology/Body%20form/body_form_ant.jpg","type":1}]},{"id":9,"uid":"360ba5c2-53cb-44d3-a830-e9ffc70d5710","name":"beetle-like","type":0,"feature":18,"images":[{"caption":"Example of a beetle mimic<br/>Illustrator (and &copy;) G.J. Anderson","comments":"Mimicry can include behaviour (e.g. style of walking).","path":"Images/features/Aspects%20of%20general%20morphology/Body%20form/body_form_beetle.jpg","thumb_path":"Thumbs/features/Aspects%20of%20general%20morphology/Body%20form/body_form_beetle.jpg","type":1}]},{"id":10,"uid":"9fe3e0f9-6c0a-4052-b399-4ac8d641d821","name":"fly-like","type":0,"feature":18,"images":[{"caption":"Example of a fly mimic<br/>Illustrator (and &copy;) R. Whyte","comments":"Backwards directed fly mimics have black spots on the rear of the abdomen which look like eyes; walk backwards. and wipe cephalothorax with first legs as if a fly wiping wings.","path":"Images/features/Aspects%20of%20general%20morphology/Body%20form/bodyform_fly_mimic.jpg","thumb_path":"Thumbs/features/Aspects%20of%20general%20morphology/Body%20form/bodyform_fly_mimic.jpg","type":1}]},{"id":11,"uid":"e5780b88-f964-49a6-af42-7a02b322ef05","name":"small (<4mm)","type":0,"feature":19},{"id":12,"uid":"db9b7027-0517-4d08-9b5e-386147931ae7","name":"medium (4-8mm)","type":0,"feature":19},{"id":13,"uid":"3838fdda-08fd-4756-9dc9-041c989c5bff","name":"large (8-11mm)","type":0,"feature":19},{"id":14,"uid":"3f699a47-2862-4d4b-a342-96e694e7b91d","name":"very large (>11mm)","type":0,"feature":19},{"id":15,"uid":"9644ef6f-8fe0-491a-903e-2a12d038d5a1","name":"clearly in front of  the PL Eyes","type":0,"feature":20,"images":[{"caption":"Example where the widest point is clearly in front of the PL eyes<br/>Illustrator (and &copy;) M. Żabka (QMB)","comments":"Ensure anterior eyes are vertical when deciding position of the widest point.","path":"Images/features/Aspects%20of%20general%20morphology/Widest%20point/widest_point_in_front.jpg","thumb_path":"Thumbs/features/Aspects%20of%20general%20morphology/Widest%20point/widest_point_in_front.jpg","type":1}]},{"id":16,"uid":"3f7c3ed8-3e06-4a97-a9d5-8ae7895eb0fd","name":"at or close to the PL Eyes","type":0,"feature":20,"images":[{"caption":"Example where the widest point is at or close to the PL eyes<br/>Illustrator (and &copy;) M. Żabka (QMB)","comments":"Widest point less than the diameter of the PL eyes from these eyes; Ensure anterior eyes are vertical when deciding position of the widest point.","path":"Images/features/Aspects%20of%20general%20morphology/Widest%20point/widest_point_at_PLE.jpg","thumb_path":"Thumbs/features/Aspects%20of%20general%20morphology/Widest%20point/widest_point_at_PLE.jpg","type":1}]},{"id":17,"uid":"9a9a2bc4-0d1b-4ab0-8109-5a6dc9fbfb0a","name":"clearly behind the PL Eyes","type":0,"feature":20,"images":[{"caption":"Example where the widest point is well behind the PL eyes<br/>Illustrator (and &copy;) M. Żabka (QMB)","comments":"Widest point more than the diameter of the PL eyes behind these eyes; otherwise treat as at or close to the PL eyes. Ensure anterior eyes are vertical when deciding position of the widest point.","path":"Images/features/Aspects%20of%20general%20morphology/Widest%20point/widest_point_behind_PLE.jpg","thumb_path":"Thumbs/features/Aspects%20of%20general%20morphology/Widest%20point/widest_point_behind_PLE.jpg","type":1}]},{"id":18,"uid":"d98974cf-e822-4169-9770-e84fd941b8ee","name":"central constriction","type":0,"feature":21,"images":[{"caption":"Example where there is a constriction in the width of the cephalothorax behind the PL eyes<br/>Illustrator (and &copy;) B.J. Richardson (CSIRO)","comments":"The constriction may be very deep as in the pictures but can be very slight.","path":"Images/features/Aspects%20of%20general%20morphology/Outline%20from%20above/outline_central_constriction.jpg","thumb_path":"Thumbs/features/Aspects%20of%20general%20morphology/Outline%20from%20above/outline_central_constriction.jpg","type":1}]},{"id":19,"uid":"b9b6e90e-a93e-484f-a6f2-d8d5a02a69ba","name":"pear-shaped","type":0,"feature":21,"images":[{"caption":"Example of specimens with pear-shaped cephalothorax<br/>Illustrator (and &copy;) M. Żabka (QMB)","comments":"The sides of the cephalothorax flare out to the sides clearly behind the posterior lateral eyes and are not continuously convex.Does not curve inwards anteriorly.  This flaring may be only slightly (R) or quite strongly (L). Ensure the anterior eyes are vertical when deciding shape.","path":"Images/features/Aspects%20of%20general%20morphology/Outline%20from%20above/outline_pear-shaped.jpg","thumb_path":"Thumbs/features/Aspects%20of%20general%20morphology/Outline%20from%20above/outline_pear-shaped.jpg","type":1}]},{"id":20,"uid":"9ea91892-4c7e-4005-8d07-bd57c346d7f7","name":"rounded  or lozenge shaped","type":0,"feature":21,"images":[{"caption":"Examples of rounded or lozenge-shaped cephalothorax<br/>Illustrators (and &copy;) M. Żabka (QMB), B,J, Richardson (TR) (CSIRO, MP)","comments":"Continuously convex. Curves inwards both anteriorly and posteriorly. Illustrators (and &copy;) M. Żabka (QMB), B,J, Richardson (TR) (CSIRO, MP)","path":"Images/features/Aspects%20of%20general%20morphology/Outline%20from%20above/outline_round_lozenge.jpg","thumb_path":"Thumbs/features/Aspects%20of%20general%20morphology/Outline%20from%20above/outline_round_lozenge.jpg","type":1}]},{"id":21,"uid":"e5083e8f-1575-4d4c-b238-4a4121101bd5","name":"fovea absent","type":0,"feature":22,"images":[{"caption":"Example where there is no apparent fovea<br/>Illustrator (and &copy;) B.J. Richardson (CSIRO, MP)","comments":"Check carefully as the fovea can be very small or concealed by hairs.","path":"Images/features/Aspects%20of%20general%20morphology/Fovea%20position/Fovea_position_none.jpg","thumb_path":"Thumbs/features/Aspects%20of%20general%20morphology/Fovea%20position/Fovea_position_none.jpg","type":1}]},{"id":22,"uid":"4e2d85f9-8cd7-410e-a727-4d9f0a9cd62b","name":"between PL Eyes","type":0,"feature":22,"images":[{"caption":"Example where the fovea is between the PL eyes<br/>Illustrator (and &copy;) B.J. Richardson (CSIRO, MP)","comments":"The fovea should be at least patly between the PL eyes. Check carefully as the fovea can be very small or concealed by hairs.","path":"Images/features/Aspects%20of%20general%20morphology/Fovea%20position/Fovea_position_between.jpg","thumb_path":"Thumbs/features/Aspects%20of%20general%20morphology/Fovea%20position/Fovea_position_between.jpg","type":1}]},{"id":23,"uid":"4c89d234-e265-4df6-9878-cdddd546699e","name":"behind PL Eyes","type":0,"feature":22,"images":[{"caption":"Example where the fovea is completely behind the PL eyes<br/>Illustrator (and &copy;) B.J. Richardson (CSIRO, MP)","comments":"If the fovea is even partly between the eyes, treat as if between the eyes. Check carefully as the fovea can be concealed by hairs.","path":"Images/features/Aspects%20of%20general%20morphology/Fovea%20position/Fovea_position_behind.jpg","thumb_path":"Thumbs/features/Aspects%20of%20general%20morphology/Fovea%20position/Fovea_position_behind.jpg","type":1}]},{"id":24,"uid":"d6a5e0e0-d829-4473-88c8-7233e9f2ec93","name":"fovea absent","type":0,"feature":23,"images":[{"caption":"Example where there is no apparent fovea<br/>Illustrator (and &copy;) B.J. Richardson (CSIRO)","comments":"Check carefully as the fovea can be very small or concealed by hairs.","path":"Images/features/Aspects%20of%20general%20morphology/Fovea%20length/Fovea_length_absent.jpg","thumb_path":"Thumbs/features/Aspects%20of%20general%20morphology/Fovea%20length/Fovea_length_absent.jpg","type":1}]},{"id":25,"uid":"df1657c7-e46c-40ad-9401-01c9100ef4d9","name":"short  - ≤PLE diameter","type":0,"feature":23,"images":[{"caption":"Example where the fovea is very short<br/>Illustrator (and &copy;) M. Żabka (QMB)","comments":"Less than the PL Eye diameter. Check carefully as the fovea can be concealed by hairs.","path":"Images/features/Aspects%20of%20general%20morphology/Fovea%20length/Fovea_length_short.jpg","thumb_path":"Thumbs/features/Aspects%20of%20general%20morphology/Fovea%20length/Fovea_length_short.jpg","type":1}]},{"id":26,"uid":"96a53dfa-6af2-4227-ae79-cd67a68d3df3","name":"intermediate - > PLE diameter","type":0,"feature":23,"images":[{"caption":"Example where the fovea is of an intermediate length<br/>Illustrator (and &copy;) M. Żabka (QMB)","comments":"Slightly longer than the PL eye diameter.  Check carefully as the fovea can be concealed by hairs.","path":"Images/features/Aspects%20of%20general%20morphology/Fovea%20length/Fovea_length_intermediate.jpg","thumb_path":"Thumbs/features/Aspects%20of%20general%20morphology/Fovea%20length/Fovea_length_intermediate.jpg","type":1}]},{"id":27,"uid":"50915cea-8ce6-44da-9df9-214e3bcba898","name":"long - x2 PLE diameter","type":0,"feature":23,"images":[{"caption":"Example where the fovea is quite long<br/>Illustrator (and &copy;) M. Żabka (QMB)","comments":"Fovea twice the length of the PL Eye diameter. Check carefully as the fovea can be concealed by hairs.","path":"Images/features/Aspects%20of%20general%20morphology/Fovea%20length/Fovea_length_long.jpg","thumb_path":"Thumbs/features/Aspects%20of%20general%20morphology/Fovea%20length/Fovea_length_long.jpg","type":1}]},{"id":28,"uid":"7ab85479-dca1-44e8-ab45-c8f9856dedab","name":"reach or overlap edge","type":0,"feature":24,"images":[{"caption":"Examples where there is no clear gap between PL eyes and the edge of the cephalothorax<br/>Illustrator (and &copy;) M. Żabka (QMB)","comments":"Lenses reach or overlap cephalothorax edge","path":"Images/features/Aspects%20of%20general%20morphology/posterior%20lateral%20eye%20position/PLE_setting_overlapping.jpg","thumb_path":"Thumbs/features/Aspects%20of%20general%20morphology/posterior%20lateral%20eye%20position/PLE_setting_overlapping.jpg","type":1}]},{"id":29,"uid":"d82420d8-b943-4a32-afd2-5513631c4150","name":"clear gap to edge","type":0,"feature":24,"images":[{"caption":"Examples where there is a clear gap between PL eyes and the edge of the cephalothorax<br/>Illustrator (and &copy;) M. Żabka (QMB)","comments":"Clear gap between lens and edge of the cephalothorax","path":"Images/features/Aspects%20of%20general%20morphology/posterior%20lateral%20eye%20position/PLE_setting_clear.jpg","thumb_path":"Thumbs/features/Aspects%20of%20general%20morphology/posterior%20lateral%20eye%20position/PLE_setting_clear.jpg","type":1}]},{"id":30,"uid":"daee1f65-6add-41b9-afa5-c008fa5c1a7b","name":"on distinct tubercles","type":0,"feature":25,"images":[{"caption":"Example of PL eyes placed on distinct tubercles raised above the cephalothorax surface<br/>Illustrators (and &copy;) B.J. Richardson (T) (CSIRO), M. Żabka (QMB)","path":"Images/features/Aspects%20of%20general%20morphology/PLE%20setting/PLE_setting_tubercle.jpg","thumb_path":"Thumbs/features/Aspects%20of%20general%20morphology/PLE%20setting/PLE_setting_tubercle.jpg","type":1}]},{"id":31,"uid":"d7dd5a1e-e00c-4430-82b7-e7cdf09dd28a","name":"not on distinct tubercles","type":0,"feature":25,"images":[{"caption":"Example where PL eye inserted into the smooth surface of the cephalothorax<br/>Illustrator (and &copy;) M. Żabka (QMB)","path":"Images/features/Aspects%20of%20general%20morphology/PLE%20setting/PLE_setting_smooth.jpg","thumb_path":"Thumbs/features/Aspects%20of%20general%20morphology/PLE%20setting/PLE_setting_smooth.jpg","type":1}]},{"id":32,"uid":"ac0713a4-926c-40a5-a793-594e0b2daea2","name":"much nearer lens of Anterior Lateral Eyes than Posterior Lateral Eyes","type":0,"feature":26,"images":[{"caption":"PM eyes placed closer to the AM eyes than to the PL eyes<br/>Illustrators (and &copy;) M. Żabka (L) (QMB), B.J. Richardson (CSIRO, MP)","comments":"Position relative to the nearest edges of two lenses, not the bases of the eyes","path":"Images/features/Aspects%20of%20general%20morphology/Posterior%20Median%20Eye%20-%20position/PME_position_nearer%20ALE.jpg","thumb_path":"Thumbs/features/Aspects%20of%20general%20morphology/Posterior%20Median%20Eye%20-%20position/PME_position_nearer%20ALE.jpg","type":1}]},{"id":33,"uid":"c04a7659-8396-456b-a6a0-01b1f86d446e","name":"approximately equidistant from lenses of  Anterior Lateral Eyes and Posterior Lateral Eyes","ty