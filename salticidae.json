yne%20internal/Spermatheca%20shape/simple%20tube.jpg","thumb_path":"Thumbs/features/Epigyne%20internal/Spermatheca%20shape/simple%20tube.jpg","type":1}]},{"id":166,"uid":"8359c856-8553-41e7-88a7-b6ac833fb223","name":"multichambered","type":0,"feature":71,"images":[{"caption":"Example of a multichambered spermatheca<br/>Illustrator (and &copy;) M. Żabka (QMB)","path":"Images/features/Epigyne%20internal/Spermatheca%20shape/multi-chambered_spermathecaA.jpg","thumb_path":"Thumbs/features/Epigyne%20internal/Spermatheca%20shape/multi-chambered_spermathecaA.jpg","type":1}]},{"id":167,"uid":"d869cf0f-16b3-47e6-92be-8da49b9f7413","name":"Absent","type":0,"feature":72},{"id":168,"uid":"56bf585a-16f6-4be3-b566-1addfe1ce173","name":"Present","type":0,"feature":72,"images":[{"caption":"Examples of shields coving all (T) or part (B) of the epigynum<br/>Illustrators (and &copy;) M. Eastman, (TL), M. Żabka (TR)) (QMB), B.J. Richardson (B) (CSIRO)","path":"Images/features/Epigyne%20external/Shield/Plate%20shield.jpg","thumb_path":"Thumbs/features/Epigyne%20external/Shield/Plate%20shield.jpg","type":1}]},{"id":169,"uid":"c972b48e-8f4d-4736-8e00-0254aaceeca1","name":"Absent","type":0,"feature":73},{"id":170,"uid":"3d4dd477-c2de-4b31-9c30-5fb4b8dffa02","name":"Present","type":0,"feature":73,"images":[{"caption":"Examples of insemination ducts with a single accessory gland<br/>Illustrator (and &copy;) B.J. Richardson (T) (CSIRO MP), M. Żabka (QMB)","comments":"Note the corona surrounding the end of the accessory gland but not found for a diverticulum (i.e a blind passage).","path":"Images/features/Epigyne%20internal/Insemination%20duct%20-%20gland%20number/duct_gland_number.jpg","thumb_path":"Thumbs/features/Epigyne%20internal/Insemination%20duct%20-%20gland%20number/duct_gland_number.jpg","type":1}]},{"id":171,"uid":"02e2a31b-2f77-4742-92cc-c5d70846f1c6","name":"absent","type":0,"feature":74},{"id":172,"uid":"edf6144e-6ed0-4509-9cc3-aae27ec4b9d5","name":"in distal third","type":0,"feature":74,"images":[{"caption":"Accessory gland in distal third<br/>Illustrators (and &copy;) M. Żabka (T) (QMB), B.J. Richardson (B) (CSIRO, MP)","comments":"Note the corona surrounding the end of the accessory gland not found for a diverticulum (i.e a blind passage).","path":"Images/features/Epigyne%20internal/Insemination%20duct%20gland%20position/distal%20gland.jpg","thumb_path":"Thumbs/features/Epigyne%20internal/Insemination%20duct%20gland%20position/distal%20gland.jpg","type":1}]},{"id":173,"uid":"b1a7bc41-d05d-462e-8510-b689cde1b1a7","name":"in central third","type":0,"feature":74,"images":[{"caption":"Accessory gland in central third<br/>Illustrator (and &copy;) M. Żabka (QMB)","comments":"Note the corona surrounding the end of the accessory gland not found for a diverticulum (i.e a blind passage).","path":"Images/features/Epigyne%20internal/Insemination%20duct%20gland%20position/central%20gland.jpg","thumb_path":"Thumbs/features/Epigyne%20internal/Insemination%20duct%20gland%20position/central%20gland.jpg","type":1}]},{"id":174,"uid":"d1277784-d2f9-4b35-a445-8ee5e48e5783","name":"in proximal third","type":0,"feature":74,"images":[{"caption":"Accessory gland in proximal third<br/>Illustrator (and &copy;) M. Żabka (QMB)","comments":"Note the diverticulum arising from the spermatheca overlaying the insemination duct in the lower picture.","path":"Images/features/Epigyne%20internal/Insemination%20duct%20gland%20position/proximal%20gland.jpg","thumb_path":"Thumbs/features/Epigyne%20internal/Insemination%20duct%20gland%20position/proximal%20gland.jpg","type":1}]},{"id":175,"uid":"d972df40-b991-49d2-8ad2-a889cc624d0d","name":"absent","type":0,"feature":75},{"id":176,"uid":"d01606b4-788a-4e17-9ffa-3813dd2c5838","name":"Present","type":0,"feature":75,"images":[{"caption":"Single accessory gland (T) or diverticulum (B)<br/>Illustrator (and &copy;) M. Żabka","comments":"Note the corona surrounding the end of the accessory gland not found for a diverticulum (i.e.a blind passage).","path":"Images/features/Epigyne%20internal/Accessory%20gland%20number%20spermatheca/one%20gland%20%20revised.jpg","thumb_path":"Thumbs/features/Epigyne%20internal/Accessory%20gland%20number%20spermatheca/one%20gland%20%20revised.jpg","type":1}]},{"id":177,"uid":"a1b0542a-245f-4b74-88a2-ad5c126ca60d","name":"absent","type":0,"feature":76},{"id":178,"uid":"8ea7ec7d-7607-4a49-8298-f83c973196e6","name":"on the lateral side","type":0,"feature":76,"images":[{"caption":"Opening on the lateral sides<br/>Illustrator (and &copy;) M. Żabka (QMB)","path":"Images/features/Epigyne%20internal/Spermatheca%20gland%20position/lateral.jpg","thumb_path":"Thumbs/features/Epigyne%20internal/Spermatheca%20gland%20position/lateral.jpg","type":1}]},{"id":179,"uid":"c269e505-b353-4f44-8f1b-864d951c9e91","name":"on the medial side","type":0,"feature":76,"images":[{"caption":"Opening on the medial side<br/>Illustrator (and &copy;) M. Żabka (QMB)","path":"Images/features/Epigyne%20internal/Spermatheca%20gland%20position/median%20glands.jpg","thumb_path":"Thumbs/features/Epigyne%20internal/Spermatheca%20gland%20position/median%20glands.jpg","type":1}]},{"id":180,"uid":"b070f629-c8e9-422f-b8ca-c85b94a75a8a","name":"on the ventral side","type":0,"feature":76,"images":[{"caption":"Opening in the ventral side<br/>\\Illustrator (and &copy;) B.J. Richardson (CSIRO, MP)","path":"Images/features/Epigyne%20internal/Spermatheca%20gland%20position/Ventral.jpg","thumb_path":"Thumbs/features/Epigyne%20internal/Spermatheca%20gland%20position/Ventral.jpg","type":1}]},{"id":181,"uid":"44f72617-5c33-49d0-a461-c1b38cb8bff7","name":"on the anterior side","type":0,"feature":76,"images":[{"caption":"Opening on the anterior side<br/>Illustrator (and &copy;) M. Żabka (QMB)","path":"Images/features/Epigyne%20internal/Spermatheca%20gland%20position/anterior.jpg","thumb_path":"Thumbs/features/Epigyne%20internal/Spermatheca%20gland%20position/anterior.jpg","type":1}]},{"id":182,"uid":"b229b731-7bf8-464f-bbcd-c11c1897376f","name":"very short or non-existent","type":0,"feature":77,"images":[{"caption":"Examples of very short extension<br/>Illustrator (and &copy;) M. Żabka (QMB)","comments":"The extension leading to the fertilization duct is little more than a pore in the surface of the spermatheca.","path":"Images/features/Epigyne%20internal/Fertilization%20duct%20size/vetigial.jpg","thumb_path":"Thumbs/features/Epigyne%20internal/Fertilization%20duct%20size/vetigial.jpg","type":1}]},{"id":183,"uid":"6d593af5-4846-4e64-8f4c-59cc36600cd9","name":"short","type":0,"feature":77,"images":[{"caption":"Examples of short extension<br/>Illustrator (and &copy;) M. Żabka (QMB)","comments":"The extension leading to the fertilization duct begins at some point on the surface of the spermatheca and can extend in any direction.","path":"Images/features/Epigyne%20internal/Fertilization%20duct%20size/short.jpg","thumb_path":"Thumbs/features/Epigyne%20internal/Fertilization%20duct%20size/short.jpg","type":1}]},{"id":184,"uid":"d7c3e8e3-8140-4359-aef1-930c174fe7c5","name":"long","type":0,"feature":77,"images":[{"caption":"Examples of long extension<br/>Illustrator (and &copy;) M. Żabka (QMB)","comments":"The extension leading to the fertilization duct begins at some point on the surface of the spermatheca and can extend in any direction.","path":"Images/features/Epigyne%20internal/Fertilization%20duct%20size/long.jpg","thumb_path":"Thumbs/features/Epigyne%20internal/Fertilization%20duct%20size/long.jpg","type":1}]},{"id":185,"uid":"a837497c-d98b-4d20-89e9-6f3ea3fe0056","name":"anterior","type":0,"feature":78,"images":[{"caption":"Example of a fertilization duct opening placed anteriorly<br/>Illustrator (and &copy;) M. Żabka (QMB)","comments":"The extension leading to the fertilization duct begins at some point on the surface of the spermatheca and can extend in any direction.","path":"Images/features/Epigyne%20internal/Fertilization%20duct%20-%20position/opening%20to%20the%20midline%20cosmoph